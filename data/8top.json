[
  "Kesinlikle evet.",
  "Hiç şüphen olmasın.",
  "Evet, hem de nasıl.",
  "Gördüğüm kadarıyla evet.",
  "Büyük ihtimalle.",
  "İşaretler evet diyor.",
  "Evet ama acele etme.",
  "Bence olur.",
  "Şu an söyleyemem, sonra tekrar sor.",
  "Biraz bekle, sis dağılsın.",
  "Cevap yolda ama henüz gelmedi.",
  "Bunu sana şimdi söylemesem daha iyi.",
  "Odaklan ve tekrar sor.",
  "Belki… belki de değil.",
  "Bence hiç bulaşma.",
  "Cevabım hayır.",
  "Kaynaklarım hayır diyor.",
  "Pek umut verici görünmüyor.",
  "Çok şüpheli.",
  "Rüyanda görürsün.",
  "Hayır, ve bir daha sorma.",
  "Yıldızlar buna gülüyor.",
  "Evet, ama kimseye söyleme.",
  "Hayır gibi duran bir evet.",
  "Önce bir çay koy, sonra konuşalım."
