# Bu dosya şablondur ve commit edilir. Gerçek değerler .env içine yazılır.
# Kurulum: cp .env.example .env

# Owner numarası — ülke kodu ile, başında + veya boşluk olmadan.
# ownerOnly işaretli komutlar yalnızca bu numara için çalışır.
# Örnek: 905551112233
OWNER_NUMBER=

# Owner'ın LID kimliği (isteğe bağlı). WhatsApp özel sohbette numarayı vermeyip
# yalnızca "...@lid" gönderirse ownerOnly komutlar sessiz kalır; log'da
# "Yetkisiz komut denemesi" satırındaki sender değeri buraya yazılır.
# Grupta `.id` yazınca "Sen" satırında da görünür. Örnek: 30344061436076@lid
OWNER_LID=

# Komut ön eki
PREFIX=.

# Botun kendine verdiği ad (sticker paketi, yardım metni vb. için)
BOT_NAME=wp-bot

# Oyun (.kelime, .kimim) zaman aşımı, milisaniye. Boş bırakılırsa 1 saat.
# Yalnızca elle denerken kısaltmak için vardır.
OYUN_TIMEOUT_MS=

# pino log seviyesi: trace | debug | info | warn | error | silent
# NOT: Baileys'e ayrı ve daha sessiz bir logger verilir, protokol
# mesajları buradaki seviyeden etkilenmez.
LOG_LEVEL=info

# Web paneli şifresinin özeti. Şifreyi elle yazma: `npm run panel:sifre` üretir.
PANEL_SIFRE_HASH=

# Panelin dinlediği yerel port. Boş bırakılırsa 8787.
PANEL_PORT=
