# Bu dosya şablondur ve commit edilir. Gerçek değerler .env içine yazılır.
# Kurulum: cp .env.example .env

# Owner numarası — ülke kodu ile, başında + veya boşluk olmadan.
# ownerOnly işaretli komutlar yalnızca bu numara için çalışır.
# Örnek: 905551112233
OWNER_NUMBER=

# Komut ön eki
PREFIX=.

# Botun kendine verdiği ad (sticker paketi, yardım metni vb. için)
BOT_NAME=wp-bot

# pino log seviyesi: trace | debug | info | warn | error | silent
# NOT: Baileys'e ayrı ve daha sessiz bir logger verilir, protokol
# mesajları buradaki seviyeden etkilenmez.
LOG_LEVEL=info
