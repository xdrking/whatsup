# /etc/nginx/sites-available/panel dosyasına kopyalanır. panel.ornek.com yerine
# kendi alan adın. HTTPS satırlarını certbot kendisi ekler.
server {
    listen 80;
    server_name panel.ornek.com;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_set_header Host $host;
        # Panelin deneme sınırı gerçek IP'yi buradan okur. $remote_addr istemcinin
        # gönderdiği başlığı ezer, yoksa saldırgan her denemede IP uydurabilirdi.
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
